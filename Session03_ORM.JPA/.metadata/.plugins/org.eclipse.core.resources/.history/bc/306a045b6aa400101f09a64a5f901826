package com.jone.superapp.student_manager_otm_mto_mtm.entity.bidirectional;

import java.util.ArrayList;
import java.util.List;

import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.Id;
import jakarta.persistence.JoinColumn;
import jakarta.persistence.OneToMany;
import jakarta.persistence.Table;
import lombok.Data;

@Entity
@Table(name = "major")
@Data
public class Major {
	@Id
	@Column(name = "id", columnDefinition = "CHAR(2)")
	private String id;
	
	@Column(name = "name", columnDefinition = "NVARCHAR(255)")
	private String name;
	
	public Major(String id, String name) {
		this.id = id;
		this.name = name;
	}
	
	// MỘT CHUYÊN NGÀNH CÓ NHIỀU SINH VIÊN-STUDENT, TỨC LÀ MỘT MAJOR PHẢI CHỨA MỘT ARRAYLIST STUDENT
	@OneToMany(mappedBy = "major")
	private List<Student> students = new ArrayList<>();
	// students.add(đưa 1 sinh viên vào Major)
}

