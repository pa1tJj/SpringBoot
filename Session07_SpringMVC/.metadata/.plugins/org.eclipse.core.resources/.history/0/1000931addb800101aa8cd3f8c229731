package com.jone.javweb.controller;

import java.util.List;

import org.springframework.data.domain.PageRequest;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestMapping;

import com.jone.javweb.model.dto.MovieDTO;
import com.jone.javweb.model.entity.Auth;
import com.jone.javweb.model.response.MovieResponse;
import com.jone.javweb.service.GenreService;
import com.jone.javweb.service.MovieService;

import jakarta.servlet.http.HttpSession;
import lombok.RequiredArgsConstructor;

@Controller
@RequiredArgsConstructor
@RequestMapping("/phang")
public class AdminController {
	
	private final MovieService movieService;
	private final GenreService genreService;

	@GetMapping("/doing")
	public String getAdmin(HttpSession session, Model model) {
		List<MovieResponse> movies = movieService.searchMovies(null, null, PageRequest.of(0, 0));
		Auth auth = (Auth)session.getAttribute("auth");
		model.addAttribute("auth", auth);
		model.addAttribute("movies", movies);
		return "admin";
	}
	
	@GetMapping("/movie-edit-{id}") 
	public String getMovieEdit(@PathVariable Long id, Model model) {
		model.addAttribute("movie", movieService.getDetail(id));
		model.addAttribute("genre", genreService.findAll());
		return "movie-edit";
	}
	
	@GetMapping("/movie-edit") 
	public String getMovieEdit( Model model) {
		model.addAttribute("movie", new MovieDTO());
		model.addAttribute("genre", genreService.findAll());
		return "movie-edit";
	}
}
